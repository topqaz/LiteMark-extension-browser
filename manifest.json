{
  "manifest_version": 3,
  "name": "LiteMark 书签助手",
  "version": "1.0.0",
  "description": "一键将当前网页添加到 LiteMark 书签管理系统",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "64": "icons/LiteMark64.png",
      "128": "icons/LiteMark64.png",
      "512": "icons/LiteMark.png"
    }
  },
  "icons": {
      "64": "icons/LiteMark64.png",
    "128": "icons/LiteMark128.png",
    "512": "icons/LiteMark.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

