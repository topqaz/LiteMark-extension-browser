{
  "manifest_version": 3,
  "name": "LiteMark 书签助手",
  "version": "2.0.0",
  "description": "一键将当前网页添加到 LiteMark 书签管理系统，支持AI自动分类和标签。",
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "notifications",
    "bookmarks"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/LiteMark16.png",
      "32": "icons/LiteMark32.png",
      "48": "icons/LiteMark48.png",
      "128": "icons/LiteMark128.png"
    }
  },
  "icons": {
    "16": "icons/LiteMark16.png",
    "32": "icons/LiteMark32.png",
    "48": "icons/LiteMark48.png",
    "128": "icons/LiteMark128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}

